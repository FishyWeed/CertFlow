# Local dev defaults to embedded PostgreSQL (PGlite) with zero Docker required.
# For production (Neon / Supabase / Railway / Docker), set a postgresql:// URL here.
DATABASE_URL="./.local/pgdata"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-32-char-random-secret-key"
BETTER_AUTH_URL="http://localhost:5678"
PUBLIC_APP_URL="http://localhost:5678"

# Encryption key (32-byte hex = 64 hex chars) for encrypting user-supplied SMTP credentials at rest
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Default outbound mail transport:
# - "local-outbox": writes sent email previews to ./.local/outbox/ (zero setup)
# - Free HTTPS APIs (port 443 — required on Railway Free/Hobby where SMTP ports are blocked):
#   set BREVO_API_KEY (300 free/day, works with verified Gmail) or RESEND_API_KEY (100 free/day)
BREVO_API_KEY=""
RESEND_API_KEY=""
SMTP_HOST="local-outbox"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
DEFAULT_FROM_NAME="CertFlow"
DEFAULT_FROM_EMAIL="certificates@certflow.local"

# Storage adapter: "local" for dev or Railway Volume (mount at /data/uploads)
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"

# SvelteKit Node adapter (production behind Railway reverse proxy)
# BODY_SIZE_LIMIT="50M"
# PROTOCOL_HEADER="x-forwarded-proto"
# HOST_HEADER="x-forwarded-host"
