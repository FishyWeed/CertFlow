{
	"name": "certflow",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node scripts/start.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:push:ci": "drizzle-kit push --force",
		"db:studio": "drizzle-kit studio"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/nodemailer": "^8.0.2",
		"@types/papaparse": "^5.5.2",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.17",
		"@lucide/svelte": "^1.78.0",
		"@ui-sdk/core": "0.1.0-beta.14",
		"@ui-sdk/svelte": "0.1.0-beta.14",
		"better-auth": "^1.7.27",
		"drizzle-orm": "^0.45.4",
		"jszip": "^3.10.2",
		"konva": "^10.10.0",
		"nodemailer": "^10.6.1",
		"papaparse": "^5.7.1",
		"pdf-lib": "^1.17.1",
		"postgres": "^4.1.1",
		"xlsx": "^0.18.5",
		"zod": "^4.6.7"
	}
}
